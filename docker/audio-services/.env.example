# ========================================
# Audio Services (STT + TTS) 独立運用用設定
# ========================================
# 使用方法:
#   cd docker/audio-services
#   docker compose up --build -d
#
# または xangi ルートから:
#   docker compose -f docker/audio-services/docker-compose.yml up --build -d

# ========================================
# ポート設定
# ========================================
# STT API ポート (ホスト側)
# STT_PORT=18081

# TTS API ポート (ホスト側)
# TTS_PORT=18082

# ========================================
# STT (transformers backend) 設定
# ========================================
# Qwen3-ASR モデルのパス（コンテナ内）
# TRANSFORMERS_STT_MODEL_PATH=/models/qwen3-asr/qwen3-asr

# モデル ID（APIレスポンス用）
# TRANSFORMERS_STT_MODEL_ID=Qwen3-ASR-1.7B

# デバイス（cuda:0, auto, cpu）
# TRANSFORMERS_STT_DEVICE_MAP=cuda:0

# 最大生成トークン数
# TRANSFORMERS_STT_MAX_NEW_TOKENS=256

# バッチサイズ
# TRANSFORMERS_STT_MAX_BATCH_SIZE=8

# _attention_実装方式（flash_attention_2 / sdpa / 空）
# TRANSFORMERS_STT_ATTN_IMPLEMENTATION=

# ========================================
# TTS (piper-plus) 設定
# ========================================
# Piper モデルパス（コンテナ内）
# PIPER_MODEL_PATH=/app/models/tsukuyomi-chan-6lang-fp16.onnx

# Piper config.json のホスト側パス（compose volume 用）
# PIPER_CONFIG_HOST_PATH=/models/tts/config.json

# Piper config.json のコンテナ内パス（通常は変更不要）
# PIPER_CONFIG_PATH=/app/models/config.json

# デフォルト話速（0.25〜2.0）
# XANGI_AUDIO_TTS_SPEED=0.9
