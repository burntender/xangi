# CUDA ベースイメージ（共通）
FROM nvidia/cuda:13.1.1-cudnn-runtime-ubuntu24.04

# 基本パッケージインストール
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    python3 \
    python3-pip \
    python3.12-venv \
    ffmpeg \
    jq \
    && rm -rf /var/lib/apt/lists/*

# 共通ワークディレクトリ
WORKDIR /app

# CUDA ライブラリのパスを環境変数に追加
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# 共通 Python 仮想環境をセットアップ
RUN python3 -m venv /opt/common-venv \
    && /opt/common-venv/bin/pip install --upgrade pip
